# Copy to .env; the app loads this file. Exported shell variables take precedence.
# Leave REDIS_URL empty to read directly from the configured database.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_TTL_SECONDS=30
DATABASE_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=heima_mall
MYSQL_USER=root
MYSQL_PASSWORD=
# Set to 0 after schema initialization when running with a restricted DB user.
MYSQL_INITIALIZE_SCHEMA=1
DB_POOL_SIZE=32
DB_OPERATION_TIMEOUT_SECONDS=10
MAX_IN_FLIGHT_REQUESTS=128
REQUEST_QUEUE_TIMEOUT_SECONDS=3
# Optional local Unix socket instead of TCP:
# MYSQL_UNIX_SOCKET=/tmp/mysql.sock

# Optional photo product recognition. Keep the API key on the server only.
PHOTO_SEARCH_API_KEY=
PHOTO_SEARCH_BASE_URL=https://api.openai.com/v1
PHOTO_SEARCH_MODEL=gpt-4.1-mini
# Optional trusted reverse-proxy networks, comma-separated. Only peers in these
# networks may supply X-Forwarded-For for per-client photo-search limits.
# PHOTO_SEARCH_TRUSTED_PROXY=127.0.0.1/32,::1/128
