    1: PRODUCTS = [
           (1, 'AirSound Pro 降噪耳机', '让好声音，陪你走得更远', '数码科技', 39900, 59900, 80, 'headphones', '人气好物', '#e9e7f2', '40mm 动圈单元，主动降噪与通透模式自由切换。柔软记忆海绵耳罩，最长 40 小时续航。包装包含耳机、充电线和收纳袋。', 2680),
           (2, 'Everyday 城市双肩包', '轻装出发，装下你的日常', '服饰箱包', 18900, 25900, 120, 'backpack', '编辑推荐', '#f0eae1', '简洁轮廓搭配耐磨防泼水面料，独立 15.6 英寸电脑隔层。容量约 20L，多重收纳口袋，适合通勤和短途旅行。', 1820),
           (3, 'Cloud 轻盈休闲鞋', '每一步，都轻一点', '运动户外', 25900, 36900, 60, 'sneakers', '', '#e8edeb', '透气织物鞋面，轻量回弹鞋底，柔软贴合足部。中性色适合日常搭配。本演示商品为标准款，暂不支持尺码选择。', 1560),
           (4, 'Moment 香氛蜡烛', '把森林的气息带回家', '家居生活', 9900, 13900, 150, 'candle', '生活精选', '#eee6dc', '雪松与佛手柑的柔和香气，植物蜡配方，燃烧时间约 35 小时。净含量 180g，玻璃容器可重复使用。请勿无人看管燃烧。', 3210),
           (5, 'Pocket 便携蓝牙音箱', '随时随地，开启好心情', '数码科技', 22900, 32900, 90, 'speaker', '', '#e4e9f0', '小巧机身，饱满声音，蓝牙 5.3 稳定连接。最长 12 小时播放时长，附便携挂绳，适合桌面、出游和野餐。', 980),
           (6, 'Daily 陶瓷马克杯', '给忙碌的日子一点温度', '家居生活', 6900, 9900, 200, 'mug', '', '#eae5ed', '手感温润的陶瓷杯，380ml 日常容量，宽握柄方便拿取。适用于洗碗机与微波炉，细微釉色差异属于正常现象。', 4120),
           (7, 'Pure 温和洁面乳', '清爽洁净，刚刚好', '美妆个护', 8900, 12900, 180, 'skincare', '新品', '#e3ece5', '温和清洁配方，细腻泡沫，洗后清爽舒适。150ml 标准装，建议先进行局部试用。避免接触眼睛。', 760),
           (8, 'Trail 运动保温水杯', '好状态，从一口水开始', '运动户外', 11900, 16900, 100, 'bottle', '', '#e8e8db', '500ml 真空保温结构，食品接触级不锈钢内胆，旋盖密封。杯身附便携提手，适合通勤与轻户外。', 2240),
           (9, 'Frame 简约太阳镜', '阳光正好，风格随行', '服饰箱包', 14900, 21900, 70, 'sunglasses', '', '#e8e3e0', '轻量复古镜框，UV400 防护镜片，配收纳袋与擦镜布。适合日常出行，非专业运动或驾驶防护用品。', 1310),
           (10, 'Origins 精品挂耳咖啡', '在家，也有咖啡馆的片刻', '食品饮料', 5900, 7900, 240, 'coffee', '热卖', '#ede4db', '中度烘焙挂耳咖啡，坚果与可可风味。10g × 10 包独立包装，建议使用 90–95°C 热水冲泡。演示商品不用于真实销售。', 5820),
           (11, 'Glow 柔光桌面台灯', '让每个夜晚都温柔', '家居生活', 16900, 23900, 65, 'lamp', '', '#ece8dd', '三档暖光调节，触控操作，柔和漫射灯罩。USB 供电，适合床头和桌面氛围照明，附电源线。', 870),
