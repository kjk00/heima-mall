    1: def admin_tracking(order_id,payload,user,connection):
    7:     require_admin(user)
   14:     with transaction(connection):
    7:         order=admin_order(order_id,user,connection)
    6:         if order['status']!='paid' or refund_open(order_id,connection): raise MallError(409,'订单未支付或正在退款，无法更新物流')
    6:         old=order['delivery_stage']
    6:         if payload.stage==old: return order
    5:         if STAGES.index(payload.stage)<STAGES.index(old): raise MallError(409,'物流状态不能回退')
    4:         if payload.stage=='packing' and order['fulfillment_status']!='unfulfilled': raise MallError(409,'订单已经发货')
    4:         if payload.stage in {'transit','delivered'} and order['fulfillment_status']=='unfulfilled': raise MallError(409,'请先填写物流单号并发货')
    3:         connection.execute('UPDATE orders SET delivery_stage=? WHERE id=?',(payload.stage,order_id))
    3:         tracking_event(connection,order_id,payload.stage,payload.note)
    3:     return admin_order(order_id,user,connection)
       
       
    1: def discussions(product_id,connection,kind='comments',page=1,page_size=10):
