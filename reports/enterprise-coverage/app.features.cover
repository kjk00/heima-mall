    5:     result=page_data(connection,f'SELECT {columns} FROM {table} r JOIN users u ON u.id=r.user_id WHERE r.product_id=? AND r.is_visible=1 ORDER BY r.id DESC',(product_id,),page,page_size)
    5:     if table=='reviews':
    2:         result['average_rating']=connection.execute('SELECT COALESCE(AVG(rating),0) FROM reviews WHERE product_id=? AND is_visible=1',(product_id,)).fetchone()[0]
    5:     return result
       
       
