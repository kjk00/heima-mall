    1: def coupon_discount(coupon_id,subtotal,user,connection,store_id=None):
   71:     if coupon_id is None: return 0
   36:     c = connection.execute('''SELECT c.*,uc.used_order_id FROM coupons c JOIN user_coupons uc ON uc.coupon_id=c.id
   24:         WHERE c.id=? AND uc.user_id=?''',(coupon_id,user['id'])).fetchone()
   12:     if not c or c['used_order_id'] or not c['is_active'] or not c['starts_at'] <= now() < c['expires_at']: raise MallError(409,'优惠券未领取、已使用或已失效')
   10:     if c['store_id'] is not None and c['store_id'] != store_id: raise MallError(409,'优惠券仅限所属店铺使用')
    9:     if subtotal < c['threshold']: raise MallError(409,'商品金额未达到优惠券使用门槛')
    7:     discount = c['value'] if c['kind']=='amount' else (subtotal*(100-c['value'])+50)//100
    7:     return min(subtotal,discount,c['max_discount'] or subtotal)
       
       
