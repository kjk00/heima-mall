   36:                     schema={'type':'integer','minimum':1,'default':handler_parameters[key].default}
   36:                     schema['maximum']=50 if key=='page_size' else 2**31-1
   36:                     parameters.append({'name':key,'in':'query','schema':schema})
   82:             if 'store_id' in handler_parameters and '{store_id}' not in route.path:
    4:                 schema={'type':'integer','minimum':1}
