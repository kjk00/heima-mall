    2:                 parameters.append({'name':'status','in':'query','schema':{'type':'string','enum':['all','active','inactive'],'default':'all'}})
  154:         if route.operation in {'products','admin_products','admin_orders'}:
    6:             parameters.append({'name':'store_id','in':'query','schema':{'type':'integer','minimum':1}})
  154:         if route.operation == 'products':
    2:             parameters.append({'name':'on_sale','in':'query','schema':{'type':'boolean','default':False}})
    4:             parameters.extend([{'name': 'q', 'in': 'query', 'schema': {'type': 'string', 'maxLength': 100}},
    2:                                {'name': 'category', 'in': 'query', 'schema': {'type': 'string', 'maxLength': 30}},
    2:                                {'name': 'sort', 'in': 'query', 'schema': {'type': 'string', 'enum': ['recommended', 'newest', 'popular', 'price_asc', 'price_desc'], 'default': 'recommended'}}])
  154:         if route.operation in {'admin_products', 'admin_orders', 'admin_users'}:
   18:             choices = {'admin_products': ['all', 'active', 'inactive', 'low_stock'],
    6:                        'admin_orders': ['all', 'pending', 'paid', 'cancelled', 'unfulfilled', 'shipped', 'completed'],
   12:                        'admin_users': ['all', 'active', 'inactive']}[route.operation]
   12:             parameters.extend([{'name': 'q', 'in': 'query', 'schema': {'type': 'string', 'maxLength': 100}},
    6:                                {'name': 'status', 'in': 'query', 'schema': {'type': 'string', 'enum': choices, 'default': 'all'}}])
    6:             if route.operation == 'admin_products':
