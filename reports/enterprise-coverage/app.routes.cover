  154:         if route.operation in {'products', 'orders', 'admin_products', 'admin_orders', 'admin_users'}:
   20:             parameters.extend([{'name': 'page', 'in': 'query', 'schema': {'type': 'integer', 'minimum': 1, 'default': 1}},
