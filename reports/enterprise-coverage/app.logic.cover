    1: def receive(order_id, user, connection):
    6:     from app.features import refund_open,tracking_event
   12:     with transaction(connection):
    6:         order = order_data(connection, order_id, user['id'])
    5:         if refund_open(order_id,connection): raise HTTPException(409,'退款中的订单无法确认收货')
    4:         if order['status'] != 'paid' or order['fulfillment_status'] not in {'shipped', 'completed'}:
    1:             raise HTTPException(409, '订单尚未发货，无法确认收货')
    3:         if order['fulfillment_status'] == 'shipped':
    2:             connection.execute("UPDATE orders SET fulfillment_status='completed',delivery_stage='delivered',completed_at=strftime('%Y-%m-%dT%H:%M:%SZ','now') WHERE id=?", (order_id,))
    2:             tracking_event(connection,order_id,'delivered','用户已确认收货')
    3:         return order_data(connection, order_id, user['id'])
