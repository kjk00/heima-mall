    5:         search = q.strip().replace('\\', '\\\\').replace('%', '\\%').replace('_', '\\_')
    5:         parameters.extend([f'%{search}%', f'%{search}%', f'%{search}%'])
   18:     if category:
    2:         conditions.append('category=?')
