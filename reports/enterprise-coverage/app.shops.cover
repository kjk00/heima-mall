    1: def search_suggestions(request,connection,q=''):
    7:     from app import logic
    7:     user=None
    7:     try:
    7:         user=logic.current_user(request,connection)
    4:     except MallError as error:
    4:         if error.status_code!=401:raise
    7:     recent=[]
    7:     if user:
    9:         recent=connection.execute('''SELECT p.* FROM browsing_history h JOIN products p ON p.id=h.product_id
                   JOIN stores s ON s.id=p.store_id WHERE h.user_id=? AND p.is_active=1 AND s.is_active=1
    6:             ORDER BY h.sort_key DESC LIMIT 4''',(user['id'],)).fetchall()
   15:     categories=list(dict.fromkeys(r['category'] for r in recent))
    8:     interested_stores={r['store_id'] for r in recent}
    7:     clauses=['p.is_active=1','p.store_id IN (SELECT id FROM stores WHERE is_active=1)']
    7:     args=[]
    7:     if q.strip():
    2:         clauses.append("(p.name LIKE ? ESCAPE '\\' OR p.subtitle LIKE ? ESCAPE '\\' OR p.store_id IN (SELECT id FROM stores WHERE name LIKE ? ESCAPE '\\'))")
    2:         args.extend([search_pattern(q.strip())]*3)
    7:     priority=''
    7:     if categories:
    3:         priority='CASE WHEN p.category IN ('+','.join('?' for _ in categories)+') THEN 0 ELSE 1 END,'
    7:     rows=connection.execute('SELECT p.* FROM products p WHERE '+' AND '.join(clauses)+' ORDER BY '+priority+'p.sales DESC,p.id LIMIT 6',(*args,*categories)).fetchall()
           # Only show recent items when no search term is present, keeping typed suggestions relevant.
    8:     selected={r['id']:product_data(r,connection)|{'suggestion_label':'最近浏览'} for r in recent} if not q.strip() else {}
   38:     for row in rows:
   31:         if row['id'] not in selected:selected[row['id']]=product_data(row,connection)|{'suggestion_label':'感兴趣的热门好物' if row['category'] in categories else '热门好物'}
   42:     store_rows=[s for s in stores(connection,q) if s['products']]
   51:     sales={r['store_id']:r['sales'] for r in connection.execute('SELECT store_id,SUM(sales) AS sales FROM products WHERE is_active=1 GROUP BY store_id')}
   37:     store_rows.sort(key=lambda s:(s['id'] not in interested_stores,-sales.get(s['id'],0),s['id']))
   37:     for row in store_rows:row['suggestion_label']='来自最近浏览' if row['id'] in interested_stores else '热门店铺'
    7:     return {'products':list(selected.values())[:8],'stores':store_rows[:4],'personalized':bool(recent)}
       
       
    1: def store(store_id,connection):
    5:     result=store_row(store_id,connection)
    4:     if not result['is_active']:raise MallError(404,'店铺已暂停营业')
    4:     result.pop('version')
    4:     result['products']=connection.execute('SELECT COUNT(*) FROM products WHERE store_id=? AND is_active=1',(store_id,)).fetchone()[0]
    4:     return result
       
       
    1: def admin_stores(user,connection,q='',status='all',page=1,page_size=10):
    7:     require_admin(user)
    7:     clause, parameters = scope_clause(user, 's.id')
    7:     clauses,args=[clause],list(parameters)
    7:     if q:
    1:         clauses.append("(s.name LIKE ? ESCAPE '\\' OR s.description LIKE ? ESCAPE '\\')")
    1:         args.extend([search_pattern(q)]*2)
    7:     if status not in {'all','active','inactive'}:raise MallError(422,'店铺状态不正确')
    6:     if status!='all':clauses.append('s.is_active=?');args.append(status=='active')
    6:     where=' WHERE '+' AND '.join(clauses) if clauses else ''
   18:     sql='''SELECT s.*,(SELECT COUNT(*) FROM products p WHERE p.store_id=s.id) AS products,
               (SELECT COUNT(*) FROM products p WHERE p.store_id=s.id AND p.is_active=1) AS active_products,
               (SELECT COUNT(*) FROM orders o WHERE o.store_id=s.id) AS orders,
               (SELECT COALESCE(SUM(o.total),0) FROM orders o WHERE o.store_id=s.id AND o.status='paid'
               AND NOT EXISTS(SELECT 1 FROM refunds r WHERE r.order_id=o.id AND r.status='approved')) AS revenue
   12:         FROM stores s'''+where+' ORDER BY s.id DESC'
    6:     return page_data(connection,sql,tuple(args),page,page_size)
       
       
    1: def admin_store(store_id,user,connection):
    6:     store_scope(user, store_id)
    4:     return store_row(store_id,connection)
       
       
    1: def admin_create_store(payload,user,connection):
    6:     require_super_admin(user)
    5:     values=asdict(payload)
    5:     try:
   10:         with transaction(connection):
   40:             store_id=connection.execute('INSERT INTO stores('+','.join(values)+') VALUES ('+','.join('?' for _ in values)+')',tuple(values.values())).lastrowid
    1:     except sqlite3.IntegrityError:raise MallError(409,'店铺名称已存在')
    4:     return store_row(store_id,connection)
       
       
    1: def admin_update_store(store_id,payload,user,connection):
    3:     store_scope(user, store_id)
    3:     values=asdict(payload);version=values.pop('version')
    3:     try:
    6:         with transaction(connection):
    3:             store_row(store_id,connection)
   24:             result=connection.execute('UPDATE stores SET '+','.join(k+'=?' for k in values)+',version=version+1 WHERE id=? AND version=?',(*values.values(),store_id,version))
    3:             if not result.rowcount:raise MallError(409,'店铺已发生变化，请重新打开编辑窗口')
    1:     except sqlite3.IntegrityError:raise MallError(409,'店铺名称已存在')
    2:     return store_row(store_id,connection)
       
       
    1: def admin_store_status(store_id,payload,user,connection):
